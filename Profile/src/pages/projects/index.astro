---
// プロジェクトアーカイブページ。
// src/pages/projects/index.astro というファイルパスが、そのまま "/projects/" というURLになる
// (index.astroという名前は「このフォルダのトップページ」を意味する特別な名前)。
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PageToc from "../../components/PageToc.astro";

const allMissions = await getCollection("projects", ({ data }) => {
    return !!data.projectCode && data.projectCode.trim() !== "";
});
allMissions.sort((a, b) => b.data.date.localeCompare(a.data.date));

const pickupMissions = allMissions.filter((entry) => entry.data.isPickup === true);
const otherMissions = allMissions.filter((entry) => entry.data.isPickup !== true);

let baseUrl = import.meta.env.BASE_URL;
if (!baseUrl.endsWith("/")) baseUrl += "/";

// 画像パスを解決するヘルパー
const resolveImagePath = (path: string) => {
    if (path.startsWith('http')) return path;
    const cleanPath = path.startsWith('/') ? path.slice(1) : path;
    return `${baseUrl}${cleanPath}`;
};

const typeLabel = (type: string) =>
    type === 'SOLO' ? 'Solo' : type === 'TEAM' ? 'Team' : 'Other';

const tocItems = [
    ...(pickupMissions.length > 0 ? [{ id: 'pickup', label: 'PICKUP' }] : []),
    { id: 'archive', label: 'ARCHIVE' },
];
---

<!-- Layoutコンポーネントにtitle propsを渡すと、Layout.astro側の
     `const { title = "..." } = Astro.props` がこの値を受け取り、<title>タグに反映される。
     何も渡さなければLayout.astro側のデフォルト値("八幡拓音 - Profile")が使われる。 -->
<Layout title="Project Archive - 八幡拓音">
    <section class="mission-archive">
        <PageToc items={tocItems} />

        {pickupMissions.length > 0 && (
            <div class="pickup-section" id="pickup">
                <h2 class="section-title pickup-title">FEATURED PROJECTS <small>// PICKUP</small></h2>

                <div class="pickup-grid">
                    {pickupMissions.map((mission, index) => (
                        <a href={`${baseUrl}projects/${mission.slug}/`} class="mission-link pickup-link">
                            <div class="mil-border mission-item pickup-item">
                                <span class="pickup-badge">★ PICKUP</span>
                                {mission.data.thumbnail && (
                                    <div class="mission-thumbnail">
                                        <Image
                                            src={resolveImagePath(mission.data.thumbnail)}
                                            alt={mission.data.title}
                                            width={600}
                                            height={400}
                                            format="webp"
                                            quality={80}
                                            loading={index === 0 ? "eager" : "lazy"}
                                            fetchpriority={index === 0 ? "high" : "auto"}
                                        />
                                    </div>
                                )}
                                <div class="mission-content">
                                    <div class="mission-header">
                                        <span class="id">{mission.data.projectCode}</span>
                                        <span class={`type ${mission.data.productionType.toLowerCase()}`}>
                                            {typeLabel(mission.data.productionType)}
                                        </span>
                                    </div>

                                    <h3>{mission.data.title}</h3>
                                    <div class="meta">
                                        <span class="date">{mission.data.date}</span>
                                        <div class="tags-container">
                                            <div class="tags-inner">
                                                {[...Array(2)].map(() => (
                                                    <>
                                                        {mission.data.stack.map(s => <span class="tag stack">{s}</span>)}
                                                        {mission.data.technologies.map(t => <span class="tag tech">{t}</span>)}
                                                        {mission.data.tools && mission.data.tools.map(tool => <span class="tag tool">{tool}</span>)}
                                                    </>
                                                ))}
                                            </div>
                                        </div>
                                    </div>
                                    <p class="desc">{mission.data.description}</p>
                                    <div class="entry-btn">VIEW DETAILS >></div>
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        )}

        <div class="archive-section" id="archive">
            <h2 class="section-title">PROJECT ARCHIVE <small>// ALL PROJECTS</small></h2>

            <div class="filter-bar" role="group" aria-label="プロジェクトのタグフィルター">
                <button type="button" class="filter-btn active" data-filter="all">ALL</button>
                <button type="button" class="filter-btn" data-filter="solo">SOLO</button>
                <button type="button" class="filter-btn" data-filter="team">TEAM</button>
            </div>

            <div class="mission-grid">
                {otherMissions.map((mission) => (
                    <a
                        href={`${baseUrl}projects/${mission.slug}/`}
                        class="mission-link grid-link"
                        data-type={mission.data.productionType.toLowerCase()}
                    >
                        <div class="mil-border mission-item grid-item">
                            {mission.data.thumbnail && (
                                <div class="mission-thumbnail">
                                    <img src={resolveImagePath(mission.data.thumbnail)} alt={mission.data.title} loading="lazy" />
                                </div>
                            )}
                            <div class="mission-content">
                                <div class="mission-header">
                                    <span class="id">{mission.data.projectCode}</span>
                                    <span class={`type ${mission.data.productionType.toLowerCase()}`}>
                                        {typeLabel(mission.data.productionType)}
                                    </span>
                                </div>

                                <h3>{mission.data.title}</h3>
                                <div class="meta">
                                    <span class="date">{mission.data.date}</span>
                                    <div class="tags-container">
                                        <div class="tags-inner">
                                            {[...Array(2)].map(() => (
                                                <>
                                                    {mission.data.stack.map(s => <span class="tag stack">{s}</span>)}
                                                    {mission.data.technologies.map(t => <span class="tag tech">{t}</span>)}
                                                    {mission.data.tools && mission.data.tools.map(tool => <span class="tag tool">{tool}</span>)}
                                                </>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <p class="desc">{mission.data.description}</p>
                                <div class="entry-btn">VIEW DETAILS >></div>
                            </div>
                        </div>
                    </a>
                ))}
            </div>

            <p class="no-results" data-no-results hidden>該当するプロジェクトが見つかりませんでした。</p>
        </div>

        <div class="back-home">
            <a href={baseUrl} class="btn-back">
                <span class="icon"><<</span> RETURN TO HOME
            </a>
        </div>
    </section>
</Layout>

<script>
    // ALL/SOLO/TEAMのフィルターボタン。フレームワーク(React等)を使わない素のDOM操作で実装している。
    // 各カードには上のマークアップで data-type={mission.data.productionType.toLowerCase()} が
    // 埋め込まれているので、ボタンがクリックされたらその値と一致しないカードに
    // is-hidden クラスを付けて隠す、という単純な仕組み。
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLAnchorElement>('.grid-link');
    const noResults = document.querySelector<HTMLElement>('[data-no-results]');

    const applyFilter = (filter: string) => {
        let visibleCount = 0;
        cards.forEach((card) => {
            const matches = filter === 'all' || card.dataset.type === filter;
            card.classList.toggle('is-hidden', !matches);
            if (matches) visibleCount++;
        });
        if (noResults) noResults.hidden = visibleCount !== 0;
    };

    buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
            buttons.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            applyFilter(btn.dataset.filter ?? 'all');
        });
    });
</script>

<style>
    /* :where(.mission-archive) { --accent-color: ...; } は、
       Layout.astroの:rootで定義したグローバルな--accent-colorを、
       このページの.mission-archive要素の内側だけ別の紫に上書きするテクニック。
       CSSカスタムプロパティは指定した要素の内側(子孫)に自動で伝わっていく性質があるため、
       ページごとに少し違う色味を出したいときに便利。
       :where(...)を使っているのは、詳細度(CSS優先順位)を0にして他のスタイルと
       衝突しにくくするため。 */
    :where(.mission-archive) {
        --accent-color: #a070ff;
        --accent-color-rgb: 160, 112, 255;
        --accent-glow: #c0a0ff;
    }

    .mission-archive {
        margin: 40px 0;
    }

    .pickup-section {
        margin-bottom: 70px;
        padding-bottom: 50px;
        border-bottom: 1px solid rgba(var(--accent-color-rgb), 0.2);
    }

    #pickup,
    #archive {
        scroll-margin-top: 140px;
    }

    .section-title {
        font-size: 2.2rem;
        margin-bottom: 50px;
        border-left: 8px solid var(--accent-color);
        padding-left: 20px;
        color: var(--accent-color);
        letter-spacing: 0.1em;
    }

    .pickup-title {
        text-shadow: 0 0 15px rgba(var(--accent-color-rgb), 0.4);
    }

    .section-title small {
        font-size: 1rem;
        color: var(--text-sub);
        font-weight: normal;
        margin-left: 10px;
    }

    /* --- フィルターバー --- */
    .filter-bar {
        display: flex;
        gap: 12px;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }

    .filter-btn {
        font-family: "Oxanium", sans-serif;
        font-size: 0.85rem;
        font-weight: bold;
        letter-spacing: 0.08em;
        padding: 8px 22px;
        background: transparent;
        border: 1px solid rgba(var(--accent-color-rgb), 0.4);
        color: var(--text-sub);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .filter-btn:hover {
        border-color: var(--accent-color);
        color: var(--accent-glow);
    }

    .filter-btn.active {
        background: var(--accent-color);
        border-color: var(--accent-color);
        color: #000;
        box-shadow: 0 0 12px rgba(var(--accent-color-rgb), 0.5);
    }

    .no-results {
        display: block;
        margin-top: 30px;
        text-align: center;
        color: var(--text-sub);
        font-size: 0.9rem;
    }

    .no-results[hidden] {
        display: none;
    }

    /* --- ピックアップ（特別枠） --- */
    .pickup-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 25px;
    }

    .pickup-item {
        border-color: var(--accent-glow);
        box-shadow: 0 0 25px rgba(var(--accent-color-rgb), 0.15);
        position: relative;
    }

    .pickup-badge {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 2;
        background: var(--accent-color);
        color: #000;
        font-size: 0.75rem;
        font-weight: bold;
        letter-spacing: 0.08em;
        padding: 4px 14px;
        clip-path: polygon(0 0, 100% 0, 88% 100%, 0% 100%);
    }

    /* --- 通常一覧: 二列グリッド --- */
    .mission-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    @media (max-width: 900px) {
        .mission-grid {
            grid-template-columns: 1fr;
        }
    }

    .mission-link {
        text-decoration: none;
        color: inherit;
        display: block;
        min-width: 0;
    }

    .grid-link.is-hidden {
        display: none;
    }

    .mission-item {
        background: rgba(26, 20, 20, 0.4);
        transition: transform 0.2s, background 0.2s, box-shadow 0.2s;
        cursor: pointer;
        display: flex;
        flex-direction: row;
        gap: 0;
        overflow: hidden;
        min-width: 0;
    }

    @media (max-width: 768px) {
        .mission-item {
            flex-direction: column;
        }
    }

    /* 二列グリッドのカードは縦積みレイアウトにして幅に収める */
    .grid-item {
        flex-direction: column;
    }

    .grid-item .mission-thumbnail {
        width: 100%;
        height: 180px;
        border-right: none;
        border-bottom: 1px solid rgba(var(--accent-color-rgb), 0.2);
    }

    .mission-thumbnail {
        width: 300px;
        min-width: 300px;
        height: auto;
        overflow: hidden;
        border-right: 1px solid rgba(var(--accent-color-rgb), 0.2);
        background: #000;
        flex-shrink: 0;
    }

    @media (max-width: 768px) {
        .mission-thumbnail {
            width: 100%;
            height: 200px;
            border-right: none;
            border-bottom: 1px solid rgba(var(--accent-color-rgb), 0.2);
        }
    }

    .mission-thumbnail img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.8;
        transition: transform 0.3s, opacity 0.3s;
    }

    .mission-link:hover .mission-thumbnail img {
        transform: scale(1.05);
        opacity: 1;
    }

    .mission-content {
        padding: 20px;
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .mission-link:hover .mission-item {
        background: rgba(var(--accent-color-rgb), 0.1);
        transform: translateX(10px);
        box-shadow: -5px 0 0 var(--accent-color);
    }

    .grid-link:hover .grid-item {
        transform: translateY(-6px);
        box-shadow: 0 8px 0 var(--accent-color);
    }

    .mission-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 0.8rem;
        font-weight: bold;
    }

    .id {
        color: var(--accent-color);
        border: 1px solid var(--accent-color);
        padding: 2px 8px;
    }

    .type {
        padding: 2px 8px;
        border-radius: 2px;
        color: #fff;
        font-size: 0.7rem;
        font-weight: bold;
    }

    .type.solo { background: var(--tag-bg); border: 1px solid var(--accent-color); color: var(--accent-color); }
    .type.team { background: var(--accent-color); color: #000; border: 1px solid var(--accent-glow); }
    .type.other { background: #333; border: 1px solid #666; color: #fff; }

    h3 {
        font-size: 1.3rem;
        margin-bottom: 10px;
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .meta {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 15px;
        font-size: 0.8rem;
        min-width: 0;
    }

    .date {
        color: var(--accent-glow);
        font-family: monospace;
    }

    .tags-container {
        width: 100%;
        overflow: hidden;
        position: relative;
        padding: 5px 0;
        mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    }

    .tags-inner {
        display: flex;
        gap: 8px;
        width: max-content;
        animation: marquee 20s linear infinite;
    }

    .mission-link:hover .tags-inner {
        animation-play-state: paused;
    }

    @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }

    .tag {
        flex: 0 0 auto;
        color: var(--accent-color);
        background: rgba(var(--accent-color-rgb), 0.1);
        border: 1px solid rgba(var(--accent-color-rgb), 0.3);
        padding: 1px 8px;
        font-size: 0.75rem;
        font-weight: bold;
        letter-spacing: 0.05em;
        white-space: nowrap;
    }

    .tag.stack::before { content: ":: "; opacity: 0.6; }

    .tag.tech {
        color: var(--accent-glow);
        background: rgba(var(--accent-color-rgb), 0.1);
        border-color: rgba(var(--accent-color-rgb), 0.3);
    }
    .tag.tech::before { content: "> "; opacity: 0.6; }

    .tag.tool {
        color: var(--text-sub);
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.1);
    }
    .tag.tool::before { content: "+ "; opacity: 0.6; }

    .desc {
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--text-main);
        margin-bottom: 20px;
        white-space: pre-wrap;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .entry-btn {
        text-align: right;
        font-size: 0.7rem;
        color: var(--accent-color);
        font-weight: bold;
        opacity: 0.6;
        transition: all 0.3s ease;
        letter-spacing: 0.1em;
    }

    .mission-link:hover .entry-btn {
        opacity: 1;
        text-shadow: 0 0 8px var(--accent-color), 0 0 15px var(--accent-color);
        transform: scale(1.05);
        color: #fff;
    }

    .back-home {
        margin-top: 60px;
        text-align: center;
    }

    .btn-back {
        display: inline-block;
        padding: 15px 30px;
        border: 1px solid var(--accent-color);
        color: var(--accent-color);
        font-weight: bold;
        text-decoration: none;
        transition: all 0.3s ease;
        font-family: "Oxanium", sans-serif;
    }

    .btn-back:hover {
        background: var(--accent-color);
        color: #fff;
        box-shadow: 0 0 20px var(--accent-color);
    }
</style>
