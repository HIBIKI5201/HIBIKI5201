---
import Layout from "../layouts/Layout.astro";
import PageToc from "../components/PageToc.astro";
import Hero from "../components/Hero.astro";
import Profile from "../components/Profile.astro";
import MissionArchive from "../components/MissionArchive.astro";
import TrackRecord from "../components/TrackRecord.astro";
import Career from "../components/Career.astro";
import Footer from "../components/Footer.astro";

const tocItems = [
	{ id: "top", label: "TOP" },
	{ id: "profile", label: "PROFILE" },
	{ id: "projects", label: "PROJECTS" },
	{ id: "records", label: "RECORDS" },
	{ id: "career", label: "CAREER" },
];
---

<Layout>
	<PageToc items={tocItems} />
	<div id="top"><Hero /></div>
	<div id="profile"><Profile /></div>
	<div id="projects"><MissionArchive /></div>
	<div id="records"><TrackRecord /></div>
	<div id="career"><Career /></div>
	<Footer />
</Layout>

<style>
	#top, #profile, #projects, #records, #career {
		scroll-margin-top: 140px;
	}
</style>
