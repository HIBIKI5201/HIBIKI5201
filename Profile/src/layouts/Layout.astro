---
// 「レイアウト」と呼ばれる特殊なAstroコンポーネント。
// 全ページ共通の<html><head><body>の骨組みや、共通で読み込むフォント・グローバルCSS、
// ヘッダー(<Header />)をここに1か所だけ書いておき、各ページ(src/pages/以下)はこの
// Layoutで中身を「くるむ」形で使う。詳しくは下の<slot />の説明を参照。
import Header from "../components/Header.astro";

// --- ここから上下がAstroコンポーネントの「フロントマター」---
// 3本のハイフンで囲われた部分はサーバー側(ビルド時)でのみ実行されるJS/TSコード。
// ここで計算した変数やimportしたコンポーネントを、下のHTMLっぽい部分(テンプレート)から
// {変数名} という書き方で埋め込める。ブラウザには実行結果のHTMLだけが送られ、
// このコード自体はブラウザに送信されない(=クライアントのJSバンドルを増やさない)。

// Astro.props: このLayoutコンポーネントを <Layout title="...">中身</Layout> のように
// 使う側から渡された属性(props)を受け取るためのオブジェクト。
// title が渡されなかった場合のデフォルト値として "八幡拓音 - Profile" を使う。
const { title = "八幡拓音 - Profile" } = Astro.props;

// import.meta.env.BASE_URL は astro.config.mjs の base 設定から自動で決まる値。
// GitHub Pagesではサイトが https://.../HIBIKI5201/ 以下に配置されるため、
// 画像やリンクのパスには必ずこのbaseUrlを先頭に付ける必要がある。
let baseUrl = import.meta.env.BASE_URL; // "/HIBIKI5201/" になります
if (!baseUrl.endsWith("/")) baseUrl += "/";
---
<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
		<link rel="icon" href={`${baseUrl}favicon.ico`} />
		<!-- Astro.generator はAstro自身のバージョン文字列。SEO用のmetaタグとしてAstroが用意している定型句。 -->
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;700&family=Oxanium:wght@300;400;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
		<noscript>
			<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;700&family=Oxanium:wght@300;400;700&display=swap" rel="stylesheet">
		</noscript>
	</head>
	<body>
		<Header />
		<div class="overlay"></div>
		<main>
			<!--
				<slot /> はこのLayoutコンポーネントの「差し込み口」。
				例えば src/pages/index.astro では

					<Layout>
						<div id="top"><Hero /></div>
						...
					</Layout>

				のように書かれており、<Layout>タグの中に書いた内容がそのまま
				このslotの位置に展開される。ページごとに中身(Hero, Profile, ...)は違うが、
				<head>やヘッダー、全体の余白など「枠」の部分はこのLayoutで一括管理できる。
			-->
			<slot />
		</main>
	</body>
</html>

<!--
	is:global を付けたstyleタグは、Astro標準の「コンポーネントごとに自動でクラス名を
	スコープする(閉じ込める)」機能を無効化し、サイト全体に効く通常のグローバルCSSとして扱う。
	:root の中で定義しているCSSカスタムプロパティ(--accent-color など)は、
	他のすべてのコンポーネントの<style>ブロックから var(--accent-color) の形で参照できる。
	（各コンポーネント内で :where(.xxx) { --accent-color: 別の値; } のように上書きしている
	 箇所もあり、セクションごとに微妙に違う紫の色味を出す仕組みになっている）
-->
<style is:global>
	:root {
		--bg-color: #0a0a0a; /* 純粋な黒に近いグレー */
		--panel-color: #151515;
		--accent-color: #9d4edd; /* 落ち着いた、しかし存在感のある紫 */
		--accent-color-rgb: 157, 78, 221;
		--accent-glow: #c77dff;
		--warning-color: #555555; /* 警告やサブ要素はグレーで抑える */
		--text-main: #e0e0e0;
		--text-sub: #888888;
		--tag-bg: #1a1a1a; /* ここもモノトーンに */
		--border-style: 1px solid rgba(var(--accent-color-rgb), 0.3);
	}

	html {
		overflow-x: hidden;
	}

	html, body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
		background-color: var(--bg-color);
		color: var(--text-main);
		font-family: "JetBrains Mono", monospace;
		scroll-behavior: smooth;
	}

	body {
		/* グリッドも紫を抑えて白の微かな線に */
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
		background-size: 40px 40px;
	}

	.overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		/* オーバーレイの紫のグラデーションも削除し、スキャンラインのみに */
		background: linear-gradient(rgba(10, 10, 10, 0) 50%, rgba(0, 0, 0, 0.15) 50%);
		background-size: 100% 4px;
		pointer-events: none;
		z-index: 100;
		opacity: 0.3;
	}

	h1, h2, h3 {
		font-family: "Oxanium", sans-serif;
		text-transform: uppercase;
		letter-spacing: 2px;
		margin: 0;
	}

	main {
		max-width: 1000px;
		margin: 0 auto;
		padding: 100px 20px 40px;
		position: relative;
		z-index: 1;
	}

	/* サイト内で繰り返し使われる「四隅に鉤(かぎ)括弧の装飾が付いた枠線」の共通スタイル。 */
	.mil-border {
		border: var(--border-style);
		padding: 20px;
		position: relative;
		background: rgba(18, 18, 18, 0.9); /* 赤み(26,20,20)を排除 */
		backdrop-filter: blur(4px);
	}

	.mil-border::before {
		content: "";
		position: absolute;
		top: -5px;
		left: -5px;
		width: 20px;
		height: 20px;
		border-top: 2px solid var(--accent-color);
		border-left: 2px solid var(--accent-color);
	}

	.mil-border::after {
		content: "";
		position: absolute;
		bottom: -5px;
		right: -5px;
		width: 20px;
		height: 20px;
		border-bottom: 2px solid var(--accent-color);
		border-right: 2px solid var(--accent-color);
	}

	section {
		margin-bottom: 60px;
	}

	a {
		color: var(--accent-color);
		text-decoration: none;
		transition: all 0.3s ease;
	}

	a:hover {
		color: #fff;
		text-shadow: 0 0 10px var(--accent-color);
	}

	::-webkit-scrollbar {
		width: 8px;
	}

	::-webkit-scrollbar-track {
		background: var(--bg-color);
	}

	::-webkit-scrollbar-thumb {
		background: var(--tag-bg);
		border: 1px solid var(--accent-color);
	}
</style>
