---
// ヘッダコンポーネント。サイトのロゴとナビゲーションメニューを含む。
let baseUrl = import.meta.env.BASE_URL;
if (!baseUrl.endsWith("/")) baseUrl += "/";

const pathname = Astro.url.pathname;
const isProjectsPage = pathname.startsWith(`${baseUrl}projects`);

// TOP/PROFILE/RECORDS/CAREERはトップページ内のセクションへのアンカー、PROJECTSは実ページへのリンク。
const navItems = [
    { id: "top", label: "TOP", href: `${baseUrl}#top` },
    { id: "profile", label: "PROFILE", href: `${baseUrl}#profile` },
    { id: "projects", label: "PROJECTS", href: `${baseUrl}projects/` },
    { id: "records", label: "RECORDS", href: `${baseUrl}#records` },
    { id: "career", label: "CAREER", href: `${baseUrl}#career` },
];
---

<header class="main-header">
    <div class="header-container">
        <a href={baseUrl} class="logo">HIKIBI_5201</a>

        <nav class="nav-desktop">
            <ul class="nav-links">
                {navItems.map((item) => (
                    <li>
                        <a href={item.href} data-nav-id={item.id} class:list={[{ active: isProjectsPage && item.id === "projects" }]}>{item.label}</a>
                    </li>
                ))}
            </ul>
        </nav>

        <button class="hamburger" id="hamburger-menu" aria-label="Toggle Menu">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
    </div>

    <nav class="nav-mobile" id="mobile-nav">
        <ul class="nav-links">
            {navItems.map((item) => (
                <li>
                    <a href={item.href} data-nav-id={item.id} class:list={[{ active: isProjectsPage && item.id === "projects" }]}>{item.label}</a>
                </li>
            ))}
        </ul>
    </nav>

</header>

<script>
    const hamburger = document.getElementById('hamburger-menu');
    const mobileNav = document.getElementById('mobile-nav');
    const navLinks = document.querySelectorAll('.nav-mobile a');

    hamburger?.addEventListener('click', () => {
        hamburger.classList.toggle('active');
        mobileNav?.classList.toggle('active');
    });

    navLinks.forEach(link => {
        link.addEventListener('click', () => {
            hamburger?.classList.remove('active');
            mobileNav?.classList.remove('active');
        });
    });

    // トップページのセクションをスクロール位置に応じてハイライトする(存在する場合のみ動作)
    const sectionIds = ['top', 'profile', 'projects', 'records', 'career'];
    const allNavLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-links a[data-nav-id]');
    const sections = sectionIds
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => !!el);

    const setActiveSection = (id: string) => {
        allNavLinks.forEach((link) => link.classList.toggle('active', link.dataset.navId === id));
    };

    if (sections.length > 0) {
        const observer = new IntersectionObserver((entries) => {
            const visible = entries.filter((e) => e.isIntersecting);
            if (visible.length === 0) return;
            const topMost = visible.reduce((a, b) => (a.boundingClientRect.top < b.boundingClientRect.top ? a : b));
            setActiveSection(topMost.target.id);
        }, { rootMargin: '-40% 0px -50% 0px', threshold: 0 });
        sections.forEach((s) => observer.observe(s));
    }
</script>

<style>
    .main-header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        background: rgba(12, 12, 12, 0.95); /* 赤みを排除し、不透明度を調整 */
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(var(--accent-color-rgb), 0.3);
        z-index: 1000;
        padding: 10px 0;
    }

    .header-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .logo {
        font-family: "Oxanium", sans-serif;
        font-weight: bold;
        color: var(--accent-color);
        font-size: 1.2rem;
        letter-spacing: 2px;
    }

    .nav-links {
        list-style: none;
        display: flex;
        gap: 30px;
        padding: 0;
        margin: 0;
    }

    .nav-links a {
        color: var(--text-main);
        font-size: 0.9rem;
        font-weight: bold;
        transition: color 0.3s ease;
    }

    .nav-links a:hover {
        color: var(--accent-color);
    }

    .nav-links a.active {
        color: var(--accent-color);
        text-shadow: 0 0 8px rgba(var(--accent-color-rgb), 0.6);
    }

    /* Hamburger Menu */
    .hamburger {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 10px;
    }

    .bar {
        display: block;
        width: 25px;
        height: 2px;
        margin: 5px auto;
        transition: all 0.3s ease-in-out;
        background-color: var(--accent-color);
    }

    /* Mobile Nav */
    .nav-mobile {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        background: rgba(18, 18, 18, 0.95);
        border-bottom: 1px solid var(--accent-color);
        padding: 20px 0;
    }

    .nav-mobile .nav-links {
        flex-direction: column;
        align-items: center;
        gap: 20px;
    }

    @media (max-width: 768px) {
        .nav-desktop {
            display: none;
        }

        .hamburger {
            display: block;
        }

        .hamburger.active .bar:nth-child(2) {
            opacity: 0;
        }

        .hamburger.active .bar:nth-child(1) {
            transform: translateY(7px) rotate(45deg);
        }

        .hamburger.active .bar:nth-child(3) {
            transform: translateY(-7px) rotate(-45deg);
        }

        .nav-mobile.active {
            display: block;
        }
    }
</style>
