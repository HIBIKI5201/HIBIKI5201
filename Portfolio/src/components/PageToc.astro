---
// ページ内のセクションへジャンプするSticky目次。
// スクロール位置に応じて現在のセクションをハイライトする。
interface Props {
    items: { id: string; label: string }[];
}
const { items } = Astro.props;
---

{items.length > 1 && (
    <nav class="page-toc" aria-label="ページ内目次">
        <div class="page-toc-inner">
            {items.map((item) => (
                <a href={`#${item.id}`} data-toc-id={item.id} class="toc-link">{item.label}</a>
            ))}
        </div>
    </nav>
)}

<script>
    const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    const sections = Array.from(links)
        .map((link) => document.getElementById(link.dataset.tocId ?? ''))
        .filter((el): el is HTMLElement => !!el);

    const setActive = (id: string) => {
        links.forEach((link) => link.classList.toggle('active', link.dataset.tocId === id));
    };

    if (sections.length > 0) {
        const observer = new IntersectionObserver((entries) => {
            const visible = entries.filter((e) => e.isIntersecting);
            if (visible.length === 0) return;
            const topMost = visible.reduce((a, b) => (a.boundingClientRect.top < b.boundingClientRect.top ? a : b));
            setActive(topMost.target.id);
        }, { rootMargin: '-30% 0px -60% 0px', threshold: 0 });
        sections.forEach((s) => observer.observe(s));
        setActive(sections[0].id);
    }
</script>

<style>
    .page-toc {
        position: sticky;
        top: 67px;
        z-index: 500;
        margin-bottom: 30px;
        background: rgba(10, 10, 10, 0.9);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(var(--accent-color-rgb), 0.25);
    }

    .page-toc-inner {
        display: flex;
        gap: 8px;
        padding: 10px 14px;
        overflow-x: auto;
    }

    .toc-link {
        flex: 0 0 auto;
        font-family: "Oxanium", sans-serif;
        font-size: 0.8rem;
        font-weight: bold;
        letter-spacing: 0.06em;
        color: var(--text-sub);
        padding: 6px 16px;
        border: 1px solid rgba(var(--accent-color-rgb), 0.25);
        white-space: nowrap;
        transition: all 0.2s ease;
    }

    .toc-link:hover {
        color: var(--accent-glow);
        border-color: var(--accent-color);
    }

    .toc-link.active {
        color: #000;
        background: var(--accent-color);
        border-color: var(--accent-color);
        box-shadow: 0 0 10px rgba(var(--accent-color-rgb), 0.4);
    }
</style>
